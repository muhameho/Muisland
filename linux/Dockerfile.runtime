ARG DISTRO=fedora:44
FROM ${DISTRO}
RUN if [ -f /etc/alpine-release ]; then apk add --no-cache bash; fi
WORKDIR /app
COPY linux/dependencies.sh /app/linux/dependencies.sh
RUN bash /app/linux/dependencies.sh --install
RUN . /etc/os-release && case "$ID" in \
    fedora) dnf install -y xorg-x11-server-Xvfb xorg-x11-xauth dbus-daemon sway libcap tar gzip coreutils dejavu-sans-fonts ;; \
    arch) pacman -S --needed --noconfirm xorg-server-xvfb xorg-xauth dbus sway libcap tar gzip ttf-dejavu ;; \
    opensuse-tumbleweed) zypper --non-interactive install xorg-x11-server-Xvfb xauth dbus-1-daemon dbus-1-tools sway libcap-progs tar gzip dejavu-fonts ;; \
    alpine) apk add xvfb xauth dbus sway libcap-utils font-dejavu ;; \
    *) exit 1 ;; esac
# Distro sway binaries may request CAP_SYS_NICE at exec, which Docker excludes.
# This compositor is headless/pixman only: remove its extra privileges in the
# disposable test image instead of granting host capabilities to the container.
RUN getcap "$(readlink -f "$(command -v sway)")"; setcap -r "$(readlink -f "$(command -v sway)")" || true
RUN command -v dbus-run-session
COPY Cargo.toml README.md ./
COPY docs ./docs
COPY linux ./linux
RUN python3 linux/package-source.py && tar -xzf dist/*-linux-any.tar.gz -C /tmp && mkdir -p target/release && cp -R /tmp/muisland-*-linux-any/. target/release/ && python3 -m unittest discover -s linux -v && ./target/release/muisland --check-env && bash linux/package-test.sh dist/*-linux-any.tar.gz
CMD ["dbus-run-session", "--", "bash", "linux/x11-test.sh"]
